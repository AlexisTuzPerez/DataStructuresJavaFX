<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>



<?import javafx.scene.control.Label?>




<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_final_ed.controllers.ProductsTreeController" styleClass="scene"  alignment="CENTER"  spacing="10" VBox.vgrow="ALWAYS" >

    <Label text="Arból binario"   />

    <HBox   alignment="CENTER" spacing ="10" >

        <Label fx:id="confirmText" text=" "    />

        <Button text="?"    styleClass="infoText"  onAction="#infoText" />
  
  
     </HBox>



    <HBox alignment="CENTER"  spacing="10">

        <VBox   alignment="CENTER" spacing="10">

            <Button fx:id="showTree" text="showTree" onAction="#showTree" styleClass="background"/>


            <HBox alignment="CENTER" spacing="10" >
                <TextField  fx:id= "addNodeInput" text="add_Node"  styleClass="entrada"  />

                <Button fx:id="addNodeButton" text="Add Node" onAction="#addNode" styleClass="background"/>

            </HBox>

            <HBox alignment="CENTER" spacing="10" >
                <TextField  fx:id= "searchProductInput" text="buscar_producto" styleClass="entrada"  />

                <Button fx:id="searchProductButton" text="searchProduct" onAction="#searchProduct" styleClass="background"/>

            </HBox>



            <HBox alignment="CENTER" spacing="10" >
                <TextField  fx:id= "idInput" text="id_producto_a_eliminar" styleClass="entrada"  />

                <Button fx:id="deleteProduct" text="deleteProduct"  onAction="#deleteProduct" styleClass="background"/>

            </HBox>

            <HBox alignment="CENTER"  spacing="10">
                <Button fx:id="preOrder" text="preOrder" onAction="#preOrder"  styleClass="background"/>
                <Button fx:id="postOrder" text="PostOrder" onAction="#postOrder" styleClass="background"/>


            </HBox>
            <Button fx:id="inOrder" text="inOrder" onAction="#inOrder" styleClass="background"/>

        </VBox>

        <VBox  fx:id="treeBox" prefWidth="700" prefHeight="400" alignment="CENTER"  style="-fx-background-color: white;"   > 

            <Label  text="grafica "    />


        </VBox>

    </HBox>

    <Button fx:id="backButton" text="Regresar" onAction="#backMenu" styleClass="background"/>







</VBox>