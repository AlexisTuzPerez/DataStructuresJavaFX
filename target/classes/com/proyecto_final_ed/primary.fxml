<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox  xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_final_ed.controllers.PrimaryController" styleClass="scene"  alignment="CENTER"  spacing="10">


   <Label text="Menu"   styleClass="mainText" />

   <HBox   alignment="CENTER"  spacing ="10" >

      <Label text="Eliga una opción:  "    />

      <Button text="?"    styleClass="infoText"  onAction="#infoText" />


   </HBox>


   <HBox alignment="CENTER" spacing="50">
      <VBox spacing="10" >

         <Button fx:id="addProductButton" text="Agregar Productos (Listas)"  onAction="#switchToAddProduct" styleClass="background" />
         <Button fx:id="seeProductsButton" text="Ver Productos (Ordenamiento)"  onAction="#switchToSeeProducts" styleClass="background" /> 
         <Button fx:id="searchProductButton" text="Buscar productos (áboles)"  onAction="#switchToProductsTree"  styleClass="background" />
         <Button fx:id="addOrderButton" text="Agregar Pedido (Arreglos)"    onAction="#switchToAddOrder" styleClass="background" />



      </VBox >


      <VBox spacing="10">

         <Button fx:id="seeOrdersButton" text="Ver pedidos (Cola)"   onAction="#switchToSeeOrders" styleClass="background" />
         <Button fx:id="seeOrderGraphButton" text="Envíos de los pedidos (Grafos)" onAction="#switchToGraph" styleClass="background" />
         <Button fx:id="searchShipmentButton" text="Buscar Pedido por ID (Búsqueda Binaria)" onAction="#switchToSearch" styleClass="background" />
         <Button fx:id="seeShipmentOrderButton" text="Caja de productos (Pila)"  onAction="#switchToStack" styleClass="background" />

      </VBox>


   </HBox>



</VBox>
