<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.control.SplitMenuButton?>

<?import javafx.geometry.Insets?>


<VBox  xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_final_ed.controllers.BinarySearchController" styleClass="scene"  alignment="CENTER"  spacing="20">


    <Label text="Búsqueda Binaria de Pedidos"   styleClass="mainText" />
    <Label fx:id="confirmText" text=""    />

    <HBox   alignment="CENTER"  spacing ="10"  >

        <Label fx:id="texto" text="Agrege el pedido a buscar:"   />

        <Button text="?"    styleClass="infoText"  onAction="#infoText" />
  
  
    </HBox>

    <HBox   alignment="CENTER" spacing="20"    >

        <TextField  fx:id= "idInput" text="Id_Pedido" styleClass="entrada"  />
 

        <Button fx:id="searchProduct" text="Buscar Producto" onAction="#searchProduct" styleClass="background"/>

    </HBox>

    <Button fx:id="backButton" text="Regresar" onAction="#backMenu" styleClass="background"/>

 
</VBox>
