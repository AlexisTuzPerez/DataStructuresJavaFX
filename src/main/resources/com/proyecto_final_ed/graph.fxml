<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>



<?import javafx.scene.control.Label?>




<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_final_ed.controllers.GraphController" styleClass="scene"  alignment="CENTER"  spacing="10" VBox.vgrow="ALWAYS" >

    <Label text="Grafo  "   />

    <HBox   alignment="CENTER"  spacing ="10"  >

        <Label fx:id="confirmText" text=""    />

  
        <Button text="?"    styleClass="infoText"  onAction="#infoText" />
  
  
    </HBox>


    <HBox alignment="CENTER"  spacing="10">

        <VBox  fx:id="graphBox" prefWidth="700" prefHeight="400" alignment="CENTER"  style="-fx-background-color: white;"   > 




        </VBox>

        <VBox   alignment="CENTER" spacing="20"  >


            <HBox alignment="CENTER" spacing="10" >

                <Button fx:id="showGraph" text="Mostrar Grafo" onAction="#showGraphButton"  styleClass="background"/>



                <Button fx:id="showKruskal" text="Mostral Grafo Kruskal"  onAction="#showKruskal"  styleClass="background"/>


            </HBox>

            <Label  text="Añadir enlace Nodo1 Nodo2 Valor "    />

            <VBox>
                <HBox alignment="CENTER" spacing="10" >
                    <TextField  fx:id= "node1Input" text="Nodo_1" styleClass="entrada"  />
    
    
                    <TextField  fx:id= "node2Input" text="Nodo_2" styleClass="entrada"  />
    
                </HBox>

            </VBox>


            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="valueInput" text="Valor" styleClass="entrada" prefWidth="200" />
            </HBox>



            <Button fx:id="addEdgeButton" text="Añadir Enlace" onAction="#addEdge" styleClass="background"/>


            <Label  text="ELiminar nodo "    />

            <HBox alignment="CENTER" spacing="10" >
                <TextField  fx:id= "deleteNodeInput" text="(Nodo)" styleClass="entrada"  />


                <Button fx:id="deleteNodeButton" text="Eliminar Nodo "  onAction="#deleteNode" styleClass="background"/>



            </HBox>

        </VBox>

        

    </HBox>

    <Button fx:id="backButton" text="Regresar" onAction="#backMenu" styleClass="background"/>







</VBox>